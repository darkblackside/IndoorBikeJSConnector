{
  "name": "indoor-bike-js-connector",
  "version": "0.2.0",
  "description": "Connect FTMS smart trainers and heart rate straps to the browser via Web Bluetooth",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "build:demo": "vite build",
    "prepack": "npm run build"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": "false",
  "dependencies": {
    "@types/web-bluetooth": "^0.0.22"
  }
}
