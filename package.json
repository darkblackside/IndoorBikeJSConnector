{
  "name": "indoor-bike-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Indoor bike games: Web Bluetooth trainer connector, shared game core, web frontend (three.js) and multiplayer server (Colyseus)",
  "type": "module",
  "workspaces": [
    "packages/connector",
    "packages/game-core",
    "apps/web",
    "apps/server"
  ],
  "scripts": {
    "dev": "npm run dev -w @indoor-bike/web",
    "dev:https": "npm run dev:https -w @indoor-bike/web",
    "dev:server": "npm run dev -w @indoor-bike/server",
    "build": "npm run build -w indoor-bike-js-connector -w @indoor-bike/game-core -w @indoor-bike/server",
    "build:web": "npm run build -w @indoor-bike/web",
    "test": "vitest run",
    "typecheck": "tsc -p . && npm run typecheck --workspaces",
    "login:npm": "node scripts/npm-login.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
