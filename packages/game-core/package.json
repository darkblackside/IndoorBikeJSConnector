{
  "name": "@indoor-bike/game-core",
  "version": "0.1.0",
  "private": true,
  "description": "Game rules, simulation and multiplayer message types shared by the web client and the Node server",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "indoor-bike-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./zombie-ramp": {
      "indoor-bike-source": "./src/zombie-ramp/index.ts",
      "types": "./dist/zombie-ramp/index.d.ts",
      "import": "./dist/zombie-ramp/index.js"
    },
    "./net": {
      "indoor-bike-source": "./src/net/index.ts",
      "types": "./dist/net/index.d.ts",
      "import": "./dist/net/index.js"
    }
  },
  "sideEffects": false
}
