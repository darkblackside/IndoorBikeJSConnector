{
  "name": "indoor-bike-js-connector",
  "version": "0.2.0",
  "description": "Connect FTMS smart trainers and heart rate straps to the browser via Web Bluetooth",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkblackside/IndoorBikeJSConnector.git",
    "directory": "packages/connector"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "indoor-bike-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "indoor-bike-source": "./testing/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "dependencies": {
    "@types/web-bluetooth": "^0.0.22"
  }
}
