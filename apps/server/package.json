{
  "name": "@indoor-bike/server",
  "version": "0.1.0",
  "private": true,
  "description": "Multiplayer backend: Colyseus (WebSocket) on Node",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=indoor-bike-source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.28",
    "@colyseus/ws-transport": "^0.18.5",
    "@indoor-bike/game-core": "*",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/testing": "^0.18.6",
    "tsx": "^4.23.15"
  }
}
